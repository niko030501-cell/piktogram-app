# Kopiér denne fil til ".env.local" og udfyld med de rigtige værdier fra
# Supabase (Project Settings -> API). ".env.local" er ikke en del af koden,
# der deles (se .gitignore) - de samme to værdier skal også sættes som
# miljøvariabler i Netlify (Site configuration -> Environment variables),
# for at den udgivne app kan tale med Supabase.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
